PORT=5000
# development | production  (production enforces strong secrets, secure cookies)
NODE_ENV=development
# MongoDB connection string (local default shown; use your Atlas URI when hosted)
MONGODB_URI=mongodb://127.0.0.1:27017/hash2026
# Frontend origin(s) allowed by CORS / CSRF check. Comma-separate several.
# Production example: https://hash-2026.netlify.app
CORS_ORIGIN=http://localhost:5173
# Secret used to sign login tokens. Production: 32+ random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-long-random-string
# Admin account auto-created on first start (production: set a strong password)
ADMIN_EMAIL=admin@hash.local
ADMIN_PASSWORD=admin123
# OPTIONAL legacy API key for GET /api/registrations (x-admin-key header). Leave unset to disable.
# ADMIN_KEY=
# Cookie SameSite: lax (dev default) | strict | none (production default, needed when
# frontend and API are on different domains). 'none' always implies Secure.
# COOKIE_SAMESITE=lax
